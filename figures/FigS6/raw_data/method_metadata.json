    },
    "dino_logistic": {
      "label": "Frozen DINOv2 + linear classifier",
      "frozen_predictions": "dinov2_predictions.csv",
      "description": "Externally pretrained DINOv2 ViT-S/14, with frozen weights. Close target and wider context Iba1 crops; class tokens and target-mask-weighted patch tokens, averaged over four rotations. Standardization, 32-component whitened PCA, and balanced multinomial logistic regression fitted using human labels. Regularization selected by 3-fold grouped inner validation. All learned transformations and selection excluded the outer held-out animal."
    }
  },
  "validation": "Nested leave-one-animal-out outer validation; 3-fold stratified-group inner selection. Scaling, PCA, class weights and all model choices fit on training animals only.",
