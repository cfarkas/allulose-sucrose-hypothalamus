# Source this file from Bash before readiness checks and figure reproduction.
# The frozen Figure 5 CPU CNN depends on the numerical library thread count.
# Its reference training values match 64 threads; 8 and 16 diverge.
# This is a numerical execution setting, not a requirement for 64 CPU cores.
export OMP_NUM_THREADS=64
export MKL_NUM_THREADS=64
export OPENBLAS_NUM_THREADS=64
